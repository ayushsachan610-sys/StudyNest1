# StudyNest Environment Variables (Example Template)
# Copy to .env.local for local cloud development if using Supabase or AI features.
# By default, StudyNest functions 100% offline in Local Demo Mode without any keys.

# Optional: Supabase Cloud Database & Storage (Leave blank for Local Demo Mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: AI Provider Endpoint (Leave blank for deterministic rule-based revision generator)
VITE_AI_PROVIDER_KEY=
